<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="obstacle_arena">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ================= Ground ================= -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= Arena walls (12 x 12 m) ================= -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.4 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.4 0.2 1.0</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.62 1</ambient>
            <diffuse>0.55 0.57 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.4 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.4 0.2 1.0</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.62 1</ambient>
            <diffuse>0.55 0.57 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 12.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.4 1.0</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.62 1</ambient>
            <diffuse>0.55 0.57 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 12.4 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.4 1.0</size></box></geometry>
          <material>
            <ambient>0.55 0.57 0.62 1</ambient>
            <diffuse>0.55 0.57 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= Obstacles ================= -->
    <model name="obstacle_box_1">
      <static>true</static>
      <pose>2.0 1.0 0.5 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
          <material>
            <ambient>0.85 0.25 0.20 1</ambient>
            <diffuse>0.85 0.25 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_box_2">
      <static>true</static>
      <pose>2.5 -1.5 0.4 0 0 -0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.5 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.5 0.8</size></box></geometry>
          <material>
            <ambient>0.20 0.75 0.30 1</ambient>
            <diffuse>0.20 0.75 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_box_3">
      <static>true</static>
      <pose>-2.0 2.0 0.5 0 0 0.1</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 1.2 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 1.2 1.0</size></box></geometry>
          <material>
            <ambient>0.90 0.60 0.10 1</ambient>
            <diffuse>0.90 0.60 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_box_4">
      <static>true</static>
      <pose>0.5 3.5 0.3 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.4 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.4 0.6</size></box></geometry>
          <material>
            <ambient>0.30 0.55 0.85 1</ambient>
            <diffuse>0.30 0.55 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder_1">
      <static>true</static>
      <pose>-1.5 -2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.30</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.30</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.55 0.25 0.80 1</ambient>
            <diffuse>0.55 0.25 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder_2">
      <static>true</static>
      <pose>3.5 2.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
          <material>
            <ambient>0.20 0.80 0.80 1</ambient>
            <diffuse>0.20 0.80 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
